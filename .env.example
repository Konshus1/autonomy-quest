# Copy to .env and fill in. .env is gitignored. NEVER paste keys into the chat with your agent.
#
# SUBSCRIPTION MODE: you probably need NOTHING here. The loop drives the TUI agent you already
# log into (codex / claude / copilot), and its own auth is used. That's the point.
#
# API MODE: put your model key here.

# One key reaches every model — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Or bring your own provider keys instead:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Where the system reaches you when it needs a decision (interview/06-surfaces.md)
AQ_NOTIFY_EMAIL=

# NOTE: AQ_DB_URL and AQ_GRAPH are written by install.sh from your interview answers.
# They are DERIVED, not configuration. Do not set them here — a stale value here would
# silently override the database you actually installed.
