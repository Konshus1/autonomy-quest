# Secrets. Never committed. The human fills these in on their own machine.
.env

# The instance's identity — produced by the interview, unique to each person.
# An instance.yaml in the repo would mean shipping someone else's mission.
instance.yaml

# The agent's own work product: SQL it ran, logs proving what it did, schemas it derived from
# the mission. This is INSTANCE data, not repo code — and it is worth keeping on the box, so
# sync must never silently destroy it.
evidence/
mission_schema.sql

.venv/
__pycache__/
*.pyc
