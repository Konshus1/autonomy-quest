# Copy to .env and fill in. .env is gitignored. NEVER paste keys into the chat with your agent.
#
# SUBSCRIPTION MODE: you probably need NOTHING here. The loop drives the TUI agent you already
# log into (codex / claude / copilot), and its own auth is used. That's the point.
#
# API MODE: put your model key here.

# One key reaches every model — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Or bring your own provider keys instead:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Where the system reaches you when it needs a decision (interview/06-surfaces.md)
AQ_NOTIFY_EMAIL=

# Required for POST /api/approve. install.sh or the container entrypoint generates this when it is
# absent; leave it blank here rather than inventing a shared default secret.
AQ_APPROVAL_TOKEN=

# NOTE: AQ_DB_URL and AQ_GRAPH are written by install.sh from your interview answers.
# They are DERIVED, not configuration. Do not set them here — a stale value here would
# silently override the database you actually installed.

# Governed principle lifecycle: evidence ingestion and promotion are separate credentials.
# Generate distinct random values; never reuse AQ_APPROVAL_TOKEN. Promotion also binds the
# credential to one configured adjudicator identity rather than trusting a request-body alias.
AQ_GOVERNANCE_EVIDENCE_TOKEN=
AQ_GOVERNANCE_TOKEN=
AQ_GOVERNANCE_ADJUDICATOR=
# Stable context identity used for cross-environment evidence (override per deployment/domain).
AQ_ENVIRONMENT_DOMAIN=
AQ_HARNESS_ID=
