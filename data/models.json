  "cost_model": {
    "$comment": "Used to show the human a monthly estimate BEFORE they commit to a budget in 05-budget.md. A number they can see beats a lecture about model quality. Web search is metered separately \u2014 look up the current per-search price and add it in; at research-heavy cadences it can exceed the token cost.",
    "formula": "monthly_usd = cycles_per_day * 30 * ( sum_over_tiers(calls * (in_tokens/1e6 * price_in + out_tokens/1e6 * price_out)) + searches_per_cycle * price_per_search )",
    "typical_cycle": {
      "reasoning": {
        "calls": 2,
        "in_tokens": 8000,
        "out_tokens": 1500
      },
      "working": {
        "calls": 6,
        "in_tokens": 6000,
        "out_tokens": 2000
      },
      "cheap": {
        "calls": 20,
        "in_tokens": 2000,
        "out_tokens": 400
      },
      "searches": {
        "calls": 10
      }
    }
